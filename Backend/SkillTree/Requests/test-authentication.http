@baseUrl = http://localhost:5169

### Register a regular user
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "John_Doe",
  "password": "Password123"
}

### Login as the regular user
# @name loginUser
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "John_Doe",
  "password": "Password123"
}

> {%
    client.global.set("userToken", response.body.token);
%}

### Login as the seeded admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "Admin123",
  "password": "AdminPassword123"
}

> {%
    client.global.set("adminToken", response.body.token);
%}

### Get me (regular user, authorized)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{userToken}}

### Get me (admin, authorized)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{adminToken}}

### Login (unregistered user) - expected to fail
# @name loginUnregistered
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "LarryPizza",
  "password": "Password1234"
}

> {%
    client.global.set("invalidToken", response.body?.token || "invalid-token");
%}

### Get me (unauthorized) - expected to fail
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{invalidToken}}
